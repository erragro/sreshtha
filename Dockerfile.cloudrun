FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

# Bundle Postgres so a single Cloud Run container can serve the app
# without an external DB. Data lives on /tmp (tmpfs) and is rebuilt
# from app.db on every cold start.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        postgresql \
        postgresql-contrib \
        tesseract-ocr \
        tesseract-ocr-hin \
        tesseract-ocr-ben \
        tesseract-ocr-tam \
        tesseract-ocr-tel \
        tesseract-ocr-kan \
        tesseract-ocr-mar \
        libpq5 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml ./
RUN pip install --upgrade pip \
 && pip install --no-compile .

COPY app ./app
COPY data ./data
COPY cloudrun-entrypoint.sh ./entrypoint.sh
RUN chmod +x ./entrypoint.sh

ENV PORT=8080
EXPOSE 8080

CMD ["./entrypoint.sh"]
