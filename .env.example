# =============================================================================
# Sreshtha — example environment. Copy to `.env` and fill in the secrets.
# Everything here is a KEY=value line so docker-compose can `env_file: .env`
# it straight into the app container.
# =============================================================================

# Runtime — use "local" for docker-compose / dev, "production" for Cloud Run.
# APP_ENV=local rejects the default JWT secret at boot for safety.
APP_ENV=local

# JWT signing key. MUST be a long random string in every non-local env.
# Local override lets docker-compose boot without extra setup.
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_this_default_is_unsafe

# -----------------------------------------------------------------------------
# Database — docker-compose sets DATABASE_URL to the internal postgres hostname
# for the app service automatically. Only set this if you're running the app
# outside compose (e.g. a bare `uvicorn` run against local Postgres on :5435).
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql+psycopg://sreshtha:sreshtha@localhost:5435/sreshtha

# -----------------------------------------------------------------------------
# Provider selector for Contract Reader Stages 1-3 and Cardinal chat.
#   ""        — default: OpenAI
#   "openai"  — explicit OpenAI (same as default)
#   "vertex"  — Gemini via Vertex AI (requires GOOGLE_CLOUD_PROJECT + ADC)
# -----------------------------------------------------------------------------
LLM_PROVIDER=

# -----------------------------------------------------------------------------
# OpenAI — default reasoning provider.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_SMART_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# Vertex AI (Gemini) — backup reasoning path.
# Auth: mount a service-account key into the container. On the host,
# set GOOGLE_APPLICATION_CREDENTIALS_HOST to the JSON key's absolute path
# and docker-compose will bind-mount it to /secrets/gcp-key.json.
# -----------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
GEMINI_SMART_MODEL=gemini-2.5-flash
# GOOGLE_APPLICATION_CREDENTIALS_HOST=/absolute/path/to/gcp-key.json

# -----------------------------------------------------------------------------
# Sarvam AI — Indic translation (Mayura). Also usable as an LLM provider.
# -----------------------------------------------------------------------------
SARVAM_API_KEY=
SARVAM_FAST_MODEL=sarvam-105b-conversations
SARVAM_SMART_MODEL=sarvam-105b-conversations

# -----------------------------------------------------------------------------
# Google Cloud Translation v2 (Basic) — language detection only.
# Free tier is 500k chars/month.
# -----------------------------------------------------------------------------
GOOGLE_TRANSLATE_API_KEY=

# -----------------------------------------------------------------------------
# Simulator + candidate token — Cardinal legacy demo endpoints.
# -----------------------------------------------------------------------------
SIMULATOR_BASE_URL=https://sreshtha-simulator.example.com
CANDIDATE_TOKEN=demo

# -----------------------------------------------------------------------------
# Super-admin bootstrap. If set, the first signup with this email becomes
# super_admin. Otherwise the very first user to sign up gets it.
# -----------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=
